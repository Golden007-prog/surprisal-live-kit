{
  "name": "surprisal-live-kit",
  "version": "1.0.0",
  "description": "An open-source, self-hosted alternative to Mentimeter, Slido and Kahoot: live polls, word clouds, quizzes and Q&A. Phones join with a code.",
  "keywords": [
    "mentimeter-alternative",
    "slido-alternative",
    "kahoot-alternative",
    "audience-engagement",
    "live-polling",
    "quiz",
    "word-cloud",
    "presentation",
    "self-hosted",
    "white-label",
    "react",
    "vite",
    "supabase",
    "vercel"
  ],
  "homepage": "https://github.com/habit-ai/surprisal-live-kit#readme",
  "bugs": {
    "url": "https://github.com/habit-ai/surprisal-live-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/habit-ai/surprisal-live-kit.git"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "demo": "node scripts/demo.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "playwright": "1.62.1",
    "typescript": "~6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.0.0"
  }
}
