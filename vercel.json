{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/live.ts": {
      "regions": [
        "lhr1"
      ]
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/live",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/live/host",
      "destination": "/host.html"
    },
    {
      "source": "/live/host/",
      "destination": "/host.html"
    },
    {
      "source": "/live",
      "destination": "/index.html"
    },
    {
      "source": "/live/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
