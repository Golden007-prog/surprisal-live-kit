# Copy this file to .env for local builds. On Vercel, add the same names under Settings > Environment Variables.

# --- Server (Vercel only; `npm run dev` needs none of these) ---
# Supabase > Project Settings > API: the project URL and the service_role key. Keep the service key secret.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string. Hosts type it once on the host page to go live and to share decks.
# Make one with: openssl rand -hex 24
LIVE_ADMIN_KEY=

# --- Brand (all optional; read at build time, so redeploy after a change) ---
# Your name in the top bars, the browser tab and the report. Default: Live
VITE_BRAND_NAME=
# A logo in public/ (for example /logo.svg) or a full URL. Leave unset for the default; set to nothing to hide it.
VITE_BRAND_LOGO=/logo.svg
# Where the phone's last screen links to, for example https://example.org
VITE_BRAND_URL=
# The address the screen shows for phones, for example live.example.org. Default: the site's own address.
VITE_JOIN_HOST=
